# orkestrator env file template. Never put real values in this file.
# On the host: copy it to ~/.config/orkestrator/env, run chmod 600 on the copy, then fill in the empty values.
# The daemon reads the copy with --env-file. Variables are described in docs/configuration.md.

# Bot token from @BotFather (secret).
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids that may use the bot.
TELEGRAM_ALLOWED_USER_IDS=
# pi-ai provider id.
PI_PROVIDER=deepseek
# Model id of the provider: deepseek-flash (DeepSeek V4.1 Flash) or deepseek-v4-pro.
PI_MODEL=deepseek-flash
# Thinking level; deepseek-flash supports off, low, high and max.
PI_THINKING=high
# DeepSeek API key (secret); the deepseek provider reads it.
DEEPSEEK_API_KEY=
# The agent's working directory; it must exist (ops/deploy-pi.sh creates it).
PI_WORKDIR=/home/orkestrator/work
# Compact the context when it grows past this many tokens.
PI_CONTEXT_CAP=128000
# provider/model that describes images and scanned PDF pages when the main model has no image input
# (deepseek-v4-pro has none); off turns it off.
PI_VISION_MODEL=deepseek/deepseek-flash
# Comma-separated plugins (search, mcp, skills, helpers, reminders); empty loads none.
PI_PLUGINS=
